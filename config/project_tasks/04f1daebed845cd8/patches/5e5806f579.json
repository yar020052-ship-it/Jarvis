  "diff": "--- autonomy/cycle.py\n+++ autonomy/cycle.py\n@@ -12,6 +12,7 @@\n import time\n \n from . import journal as journal_mod\n+from . import idle as idle_mod\n \n _thread: threading.Thread | None = None\n _stop = threading.Event()\n@@ -149,6 +150,10 @@\n         last_run = journal_mod.last_run()\n         now = time.time()\n         \n+        if cfg[\"idle_only\"] and not idle_mod.is_idle(cfg[\"idle_after\"]):\n+            time.sleep(10)\n+            continue\n+\n         do_repair = cfg[\"auto_repair\"] and (\n             now - last_run.get(\"repair\", 0) > cfg[\"repair_every\"]\n         )\n@@ -159,26 +164,31 @@\n             now - last_run.get(\"scout\", 0) > cfg[\"scout_every\"]\n         )\n \n+        ran_something = False\n         if do_repair:\n             journal_mod.add(\n                 \"repair\",\n                 run_repair(),\n                 ok=not _stop.is_set()\n             )\n+            ran_something = True\n         elif do_optimize:\n             journal_mod.add(\n                 \"optimize\",\n                 run_optimize(),\n                 ok=not _stop.is_set()\n             )\n+            ran_something = True\n         elif do_scout:\n             journal_mod.add(\n                 \"scout\",\n                 run_scout(),\n                 ok=not _stop.is_set()\n             )\n+            ran_something = True\n         \n-        time.sleep(10)\n+        if not ran_something:\n+            time.sleep(10)\n \n \n def start() -> None:",
